generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model machine {
  id        String  @id
  url       String
  name      String?
  locationX Int?
  locationY Int?
}

model machineusage {
  id         Int                 @id @default(autoincrement())
  userId     Int
  machineId  String
  action     machineusage_action
  parameters Json
  createdAt  DateTime            @default(now())

  @@index([machineId], map: "MachineUsage_machineId_fkey")
  @@index([userId], map: "MachineUsage_userId_fkey")
}

model user {
  id           Int      @id @default(autoincrement())
  email        String   @unique(map: "User_email_key")
  name         String?
  passwordHash String
  credits      Int?     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime
}

model usertoken {
  token     String    @id
  userId    Int
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId], map: "UserToken_userId_fkey")
}

model wallettransaction {
  id             Int      @id @default(autoincrement())
  userId         Int
  credits        Int
  machineUsageId Int?
  createdAt      DateTime @default(now())

  @@index([machineUsageId], map: "WalletTransaction_machineUsageId_fkey")
  @@index([userId], map: "WalletTransaction_userId_fkey")
}

enum machineusage_action {
  start
  stop
  pause
  resume
}
